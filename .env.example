# Copy to .env; never commit credentials. SQL server must already be provisioned.
MSSQL_SERVER=localhost
# Set PORT or INSTANCE, never both. Instance needs SQL Browser or native driver.
MSSQL_INSTANCE=SQLEXPRESS
MSSQL_PORT=
MSSQL_DATABASE=JourneyHub
# sql or windows (Windows needs msnodesqlv8 + ODBC Driver 17/18 + rebuild:native)
MSSQL_AUTH=sql
# tedious uses TCP; msnodesqlv8 also supports local shared memory when TCP is disabled.
MSSQL_DRIVER=tedious
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Integration tests require a dedicated database with a name ending in _test.
JOURNEY_SQL_TEST=false
